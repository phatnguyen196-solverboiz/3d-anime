{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animeflow.local/schemas/story-edit.schema.json",
  "title": "StoryEditRequest",
  "description": "An ordered, atomic set of edits to a project revision. Preview and apply use the same request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "operations"],
  "properties": {
    "expected_revision": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/reorderShots"},
          {"$ref": "#/$defs/setShotDuration"},
          {"$ref": "#/$defs/setVoiceText"}
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "format": "uuid"},
    "reorderShots": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "scene_id", "shot_ids"],
      "properties": {
        "op": {"const": "reorder_shots"},
        "scene_id": {"$ref": "#/$defs/id"},
        "shot_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "setShotDuration": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "shot_id", "duration_frames"],
      "properties": {
        "op": {"const": "set_shot_duration"},
        "shot_id": {"$ref": "#/$defs/id"},
        "duration_frames": {"type": "integer", "minimum": 1, "maximum": 100000000}
      }
    },
    "setVoiceText": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "voice_line_id", "text"],
      "properties": {
        "op": {"const": "set_voice_text"},
        "voice_line_id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S"},
        "audio_policy": {
          "enum": ["reject", "detach"], "default": "reject",
          "description": "Changing text with linked audio requires explicit detach. The source asset is retained."
        }
      }
    }
  }
}

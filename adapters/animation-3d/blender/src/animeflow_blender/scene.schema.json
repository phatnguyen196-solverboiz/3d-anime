{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animeflow.local/schemas/blender-scene-v1.json",
  "title": "BlenderSceneV1",
  "description": "Safe, declarative primitive scene. Stored in shot.extensions['animeflow.blender.scene.v1'].",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera", "objects"],
  "properties": {
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "samples": {"type": "integer", "minimum": 1, "maximum": 128},
    "world_color": {"$ref": "#/$defs/color"},
    "camera": {
      "type": "object", "additionalProperties": false,
      "required": ["location", "target"],
      "properties": {
        "location": {"$ref": "#/$defs/vector"},
        "target": {"$ref": "#/$defs/vector"},
        "type": {"enum": ["perspective", "orthographic"]},
        "lens_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
        "ortho_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
      }
    },
    "lights": {"type": "array", "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "location", "energy"],
      "properties": {
        "type": {"enum": ["area", "point", "sun"]},
        "location": {"$ref": "#/$defs/vector"},
        "energy": {"type": "number", "minimum": 0, "maximum": 100000},
        "color": {"$ref": "#/$defs/rgb"},
        "size": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
      }
    }},
    "objects": {"type": "array", "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "primitive"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_.-]+$"},
        "primitive": {"enum": ["cube", "uv_sphere", "plane", "cylinder", "cone"]},
        "location": {"$ref": "#/$defs/vector"},
        "rotation_deg": {"$ref": "#/$defs/vector"},
        "scale": {"$ref": "#/$defs/positiveVector"},
        "color": {"$ref": "#/$defs/color"},
        "metallic": {"type": "number", "minimum": 0, "maximum": 1},
        "roughness": {"type": "number", "minimum": 0, "maximum": 1},
        "rigid_body": {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["active", "passive"]},
            "mass": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000}
          }
        },
        "keyframes": {"type": "array", "maxItems": 10000, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["frame", "location"],
          "properties": {
            "frame": {"type": "integer", "minimum": 0},
            "location": {"$ref": "#/$defs/vector"},
            "rotation_deg": {"$ref": "#/$defs/vector"},
            "scale": {"$ref": "#/$defs/positiveVector"}
          }
        }}
      }
    }}
  },
  "$defs": {
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -100000, "maximum": 100000}},
    "positiveVector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000}},
    "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "color": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}
  }
}
